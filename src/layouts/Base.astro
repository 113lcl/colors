---
import '../styles/base.css';
import '../styles/ink.css';
import { link, unbase } from '../lib/link.js';

interface Props {
  title: string;
  branch?: 'white' | 'black' | 'green' | 'red' | 'blue' | null;
  description?: string;
  scrollable?: boolean;
}

const { title, branch = null, description = 'Undertow — тёмное пространство из пяти цветовых веток.', scrollable = false } = Astro.props;

/*
  Абсолютные адреса для превью в мессенджерах и для canonical. Astro.site может
  быть не задан (например, при локальной сборке) — тогда теги просто не выводятся,
  вместо того чтобы указывать в никуда.
*/
const origin = Astro.site ? Astro.site.origin : null;
// unbase перед link — Astro.url.pathname уже может содержать префикс, и без
// этого он бы удвоился
const canonical = origin ? new URL(link(unbase(Astro.url.pathname)), origin).href : null;
const ogImage = origin ? new URL(link('/og.png'), origin).href : null;
---

<!doctype html>
<html lang="ru" data-branch={branch}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#100e0c" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Archivo:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='4' fill='%23e4ddcf'/%3E%3C/svg%3E"
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Undertow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- поднять пелену до первой отрисовки, чтобы приход в комнату не мигал фоном -->
    <script is:inline>
      try {
        var v = sessionStorage.getItem('undertow:veil');
        if (v) {
          document.documentElement.setAttribute('data-arriving', v);
          sessionStorage.removeItem('undertow:veil');
        }
      } catch (e) {}
    </script>
  </head>
  <body data-scrollable={scrollable ? 'true' : undefined}>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="ink-veil" id="ink-veil" aria-hidden="true"></div>
    <script>
      import '../scripts/ink-transition.js';
    </script>
  </body>
</html>
