---
import Room from '../../layouts/Room.astro';

/*
  Отражение в воде: несколько слоёв горизонтальных полос на разной «глубине».
  Курсор не показывает пятно — он только чуть наклоняет всю толщу, как если бы
  вы сместились на полшага у края воды.
*/
const LAYERS = [0, 1, 2, 3, 4].map((i) => ({
  depth: 0.18 + i * 0.22,
  y: 14 + i * 17,
  opacity: (0.42 - i * 0.05).toFixed(2),
  dur: (24 + i * 9).toFixed(0),
  /*
    Блик — не отрезок, а пологая волна: прямые полосы читаются строчками
    развёртки, а не отражением. Амплитуда меньше единицы по вертикали, поэтому
    рябь остаётся рябью и не превращается в узор.
  */
  lines: Array.from({ length: 6 }, (_, k) => {
    const y = k * 16 + (i % 2) * 6;
    const w = 16 + ((i * 31 + k * 17) % 46);
    const x = ((i * 23 + k * 41) % 72) - 4;
    // амплитуда в единицах viewBox: по вертикали слой сжат почти в шестьдесят
    // раз (preserveAspectRatio="none"), поэтому волна должна быть крупной
    const amp = 3.4 + ((i * 5 + k * 11) % 7) * 0.9;
    const seg = w / 4;
    return {
      d: `M${x} ${y} q${seg / 2} ${-amp} ${seg} 0 t${seg} 0 t${seg} 0 t${seg} 0`,
      h: (0.55 + ((i * 7 + k * 13) % 9) / 9).toFixed(2),
      o: (0.45 + ((i * 11 + k * 5) % 11) / 20).toFixed(2),
      dur: (17 + ((i * 9 + k * 23) % 21)).toFixed(0),
      delay: ((i * 13 + k * 7) % 19).toFixed(0),
    };
  }),
}));
---

<Room branch="blue" slug="turquoise">
  <div class="stage" id="stage">
    <div class="water">
      {
        LAYERS.map((layer) => (
          <div class="band" data-depth={layer.depth} style={`top:${layer.y}%; opacity:${layer.opacity};`} aria-hidden="true">
            <svg
              class="band-inner"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              style={`--dur:${layer.dur}s; --rest-offset:-${Number(layer.dur) / 2}s;`}
            >
              {layer.lines.map((l) => (
                <path
                  class="glimmer"
                  d={l.d}
                  fill="none"
                  stroke="var(--c-blue)"
                  stroke-width={l.h}
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                  opacity={l.o}
                  style={`--dur:${l.dur}s; --delay:-${l.delay}s; --rest-offset:-${Number(l.dur) / 2}s;`}
                />
              ))}
            </svg>
          </div>
        ))
      }
    </div>

    <div class="glint" id="glint" aria-hidden="true"></div>
    <p class="sr-only">Слои отражений, которые чуть смещаются вслед за курсором.</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .water {
    position: absolute;
    inset: 0;
  }

  /*
    Два уровня нарочно: внешний двигает курсор, внутренний — собственная петля.
    В одном элементе анимация перебила бы инлайновый translate от скрипта.
  */
  .band {
    position: absolute;
    left: -4%;
    width: 108%;
    height: 22%;
    will-change: transform;
  }

  .band-inner {
    width: 100%;
    height: 100%;
    display: block;
    /* собственное покачивание слоя — оно есть и без курсора */
    animation: band-sway var(--dur) var(--ease-amb) infinite;
    /* края отражений не обрываются о рамку экрана, а растворяются */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 21%, #000 79%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 21%, #000 79%, transparent 100%);
    filter: blur(0.7px);
  }

  /* каждый блик живёт своей жизнью: вода не мигает одним кадром */
  .glimmer {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: glimmer var(--dur) var(--ease-amb) var(--delay) infinite;
  }

  @keyframes glimmer {
    0%,
    100% {
      scale: 1 1;
      opacity: 0.55;
      translate: 0 0;
    }
    50% {
      scale: 1.14 0.7;
      opacity: 1;
      translate: 2.5% 0;
    }
  }

  @keyframes band-sway {
    0%,
    100% {
      translate: 0 0;
      scale: 1 1;
    }
    50% {
      translate: -1.6% 0;
      scale: 1.012 1;
    }
  }

  /* блик: он и есть «пятно за курсором», только размытое до неузнаваемости */
  .glint {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(320px, 52vmin, 640px);
    aspect-ratio: 1.7;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(ellipse, color-mix(in oklab, var(--c-blue) 22%, transparent) 0%, transparent 62%);
    transition: opacity 2600ms var(--ease-state);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .glint {
      opacity: 0.5;
    }
  }

  /*
    Без мыши блик не ждёт первого движения, а живёт сам: на телефоне вода
    не должна выглядеть выключенной, пока по ней не провели пальцем.
  */
  @media (hover: none) {
    .glint {
      opacity: 0.55;
    }
  }
</style>

<script>
  import { cursorSpot } from '../../scripts/techniques/cursor-spot.js';

  const bands = [...document.querySelectorAll('.band')];

  /*
    Смещение слоёв считается от того же сглаженного положения, что и блик:
    одна инерция на всю комнату, поэтому вода не «разъезжается» по частям.
    Синяя грамматика — ease 0.018, это несколько секунд на догон.
  */
  cursorSpot(document.getElementById('glint'), {
    ease: 0.018,
    onMove: (pos) => {
      const dx = (pos.x / innerWidth - 0.5) * 2;
      const dy = (pos.y / innerHeight - 0.5) * 2;
      for (const band of bands) {
        const depth = Number(band.dataset.depth);
        band.style.translate = `${(dx * depth * 26).toFixed(2)}px ${(dy * depth * 9).toFixed(2)}px`;
      }
    },
  });
</script>
