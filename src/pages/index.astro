---
import Base from '../layouts/Base.astro';
import BrushMark from '../components/BrushMark.astro';
import { branchRooms } from '../data/rooms.js';
import { link } from '../lib/link.js';

const MARKS = [
  { id: 'o-white', branch: 'white', href: '/white/cloud/', size: 50, label: 'выдохнуть', aria: 'Спокойная ветка', drift: '16s' },
  { id: 'o-blue', branch: 'blue', href: '/blue/deep/', size: 68, label: 'всё дальше', aria: 'Далёкая ветка', drift: '20s' },
  { id: 'o-red', branch: 'red', href: '/red/orange/', size: 42, label: 'на секунду', aria: 'Напряжённая ветка', drift: '9s' },
  { id: 'o-black', branch: 'black', href: '/black/anthracite/', size: 64, label: 'не сейчас', aria: 'Тревожная ветка', drift: '13.5s' },
  { id: 'o-green', branch: 'green', href: '/green/sage/', size: 56, label: 'то, что накопилось', aria: 'Тёплая ветка', drift: '17.5s' },
] as const;
---

<Base title="Undertow" branch={null}>
  <script is:inline>
    /*
      Первый приход за сессию мандала не встречает готовой, а собирается на
      глазах: сначала тихая точка, потом кольцо, потом пять меток по очереди.
      Дальше в этой же сессии — сразу, чтобы возвращение к центру между комнатами
      не превращалось в заставку. Флаг ставится до отрисовки, иначе метки успели
      бы мигнуть на своих местах.
    */
    try {
      if (!sessionStorage.getItem('undertow:entered')) {
        document.documentElement.setAttribute('data-first', '');
        sessionStorage.setItem('undertow:entered', '1');
      }
    } catch (e) {}
  </script>

  <script>
    import { seenByBranch } from '../scripts/trace.js';

    /*
      Лужица проявляется не сразу: сначала мандала должна прочитаться как она есть,
      и только потом, уже на глазах, под метками проступает то, что накопилось.
      Размер ветки приходит атрибутом со сборки — тянуть ради одного числа всю
      карту сайта в браузер незачем.
    */
    const counts = seenByBranch();

    setTimeout(() => {
      for (const el of document.querySelectorAll('.orb-wrap[data-branch]')) {
        const seen = counts[el.dataset.branch] ?? 0;
        if (!seen) continue;
        const total = Number(el.dataset.rooms) || 4;
        el.style.setProperty('--visited', String(Math.min(seen / total, 1)));
      }
    }, 900);
  </script>

  <div class="scene">
    <header>
      <div>
        <div class="wordmark">Undertow</div>
        <span class="wordmark-rule"></span>
      </div>
    </header>

    <div class="field" id="field">
      <div class="mandala">
        <svg class="enso" viewBox="0 0 200 200" aria-hidden="true">
          <path d="M 100 18 A 82 82 0 1 1 38 47" fill="none" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" opacity="0.14"></path>
        </svg>

        <div class="ripple" style="animation-delay:0s;"></div>
        <div class="ripple" style="animation-delay:-3s;"></div>
        <div class="ripple" style="animation-delay:-6s;"></div>
        <div class="center-point"></div>

        {
          MARKS.map((m) => (
            <a
              class="orb-wrap"
              id={m.id}
              href={link(m.href)}
              aria-label={m.aria}
              data-branch={m.branch}
              data-rooms={branchRooms(m.branch).length}
            >
              <span class="orb-drift" style={`animation-duration:${m.drift}; --rest-offset:-${parseFloat(m.drift) / 2}s;`}>
                <span class="pool" aria-hidden="true"></span>
                <BrushMark branch={m.branch} size={m.size} class="orb" />
              </span>
              <span class="orb-label">{m.label}</span>
            </a>
          ))
        }
      </div>

      <a class="placard" href={link("/colophon/")} aria-label="Колофон">undertow &nbsp; 心</a>
    </div>

    <footer>
      <div class="hint">Выберите точку</div>
      <div class="hint">Undertow — 2026</div>
    </footer>
  </div>
</Base>

<style>
  header {
    position: relative;
    z-index: 2;
    padding: clamp(20px, 4vw, 44px) var(--pad-x) 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .field {
    position: relative;
    flex: 1;
    z-index: 1;
  }

  footer {
    position: relative;
    z-index: 2;
    padding: 0 var(--pad-x) var(--pad-y);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 8px;
  }

  .placard {
    bottom: 8%;
    left: 6%;
    pointer-events: auto;
    transition: opacity var(--dur-micro) var(--ease-micro);
  }
  .placard:hover,
  .placard:focus-visible {
    opacity: 0.72;
  }

  /*
    Сборка мандалы при первом приходе. Порядок: точка — кольцо — метки по одной,
    от белой по часовой. Каждой задан свой --rest-offset за конец анимации,
    иначе без движения композиция замерла бы несобранной.
  */
  :global(html[data-first]) .center-point,
  :global(html[data-first]) .enso,
  :global(html[data-first]) .orb-wrap {
    animation-name: enter-settle;
    animation-duration: 1.6s;
    animation-timing-function: cubic-bezier(0.22, 0.61, 0.24, 1);
    animation-fill-mode: backwards;
  }

  /* у точки своя петля дыхания: её нельзя затирать, поэтому обе анимации разом */
  :global(html[data-first]) .center-point {
    animation:
      enter-settle 1.6s cubic-bezier(0.22, 0.61, 0.24, 1) 0.25s backwards,
      breathe 7s var(--ease-amb) 1.85s infinite;
    --rest-offset: -2s;
  }
  :global(html[data-first]) .enso {
    animation-delay: 0.9s;
    --rest-offset: -2.6s;
  }
  :global(html[data-first]) #o-white {
    animation-delay: 1.7s;
    --rest-offset: -3.4s;
  }
  :global(html[data-first]) #o-blue {
    animation-delay: 2.1s;
    --rest-offset: -3.8s;
  }
  :global(html[data-first]) #o-red {
    animation-delay: 2.5s;
    --rest-offset: -4.2s;
  }
  :global(html[data-first]) #o-black {
    animation-delay: 2.9s;
    --rest-offset: -4.6s;
  }
  :global(html[data-first]) #o-green {
    animation-delay: 3.3s;
    --rest-offset: -5s;
  }

  /*
    Метки и энсо уже стоят на translate(-50%,-50%) — собственный transform
    анимации его бы стёр, поэтому появление идёт по opacity и scale отдельным
    свойством: scale не конфликтует с transform.
  */
  @keyframes enter-settle {
    from {
      opacity: 0;
      scale: 0.72;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  /* дыхание и дрейф ждут, пока композиция соберётся */
  :global(html[data-first]) .mandala {
    animation-delay: 3.9s;
  }
  :global(html[data-first]) .orb-drift {
    animation-delay: 4.2s;
  }
  :global(html[data-first]) .ripple {
    animation-delay: 1.2s;
  }
  :global(html[data-first]) .ripple:nth-of-type(2) {
    animation-delay: 4.2s;
  }
  :global(html[data-first]) .ripple:nth-of-type(3) {
    animation-delay: 7.2s;
  }

  /* мандала дышит целиком, еле-еле */
  .mandala {
    position: absolute;
    inset: 0;
    animation: mandala-breathe 12s var(--ease-amb) infinite;
    --rest-offset: -6s;
  }
  @keyframes mandala-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.012);
    }
  }

  .enso {
    position: absolute;
    pointer-events: none;
    opacity: 0.4;
    top: 50%;
    left: 50%;
    width: 64vmin;
    height: 64vmin;
    transform: translate(-50%, -50%);
  }

  /* тихая точка в центре — то, вокруг чего стоят пять настроений */
  .center-point {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.5;
    animation: breathe 7s var(--ease-amb) infinite;
    pointer-events: none;
    --rest-offset: -3.5s;
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.8);
      opacity: 0.6;
    }
  }

  /* кольца-рябь расходятся от точки, как от одного удара по чаше */
  .ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    pointer-events: none;
    animation: ripple-out 9s cubic-bezier(0.2, 0.7, 0.4, 1) infinite;
    opacity: 0;
    --rest-offset: -4.5s;
  }
  @keyframes ripple-out {
    0% {
      width: 1px;
      height: 1px;
      margin: 0;
      opacity: 0.28;
    }
    85% {
      opacity: 0;
    }
    100% {
      width: 70vmin;
      height: 70vmin;
      margin: -35vmin 0 0 -35vmin;
      opacity: 0;
    }
  }

  .orb-wrap {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transform: translate(-50%, -50%);
    -webkit-tap-highlight-color: transparent;
  }

  .orb-drift {
    display: block;
    position: relative;
    animation: drift 16s var(--ease-amb) infinite;
  }

  /*
    Лужица туши под меткой: копится от того, что в эту ветку заходили.
    Не счётчик и не прогресс — числа нигде нет, потолок достигается незаметно,
    ничего не открывается. Просто пространство помнит, что к нему возвращались.
  */
  .pool {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 210%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    opacity: calc(var(--visited, 0) * 0.5);
    scale: calc(0.7 + var(--visited, 0) * 0.42);
    background: radial-gradient(circle, color-mix(in oklab, var(--pool-colour, var(--ink)) 26%, transparent) 0%, transparent 62%);
    filter: blur(6px);
    transition:
      opacity 2400ms var(--ease-state),
      scale 2800ms var(--ease-state);
  }

  #o-white .pool {
    --pool-colour: var(--c-white);
  }
  #o-blue .pool {
    --pool-colour: var(--c-blue);
  }
  #o-red .pool {
    --pool-colour: var(--c-red);
  }
  #o-black .pool {
    --pool-colour: var(--c-black);
  }
  #o-green .pool {
    --pool-colour: var(--c-green);
  }

  .orb-wrap :global(.orb) {
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .orb-wrap:hover :global(.orb),
  .orb-wrap:focus-visible :global(.orb) {
    transform: scale(1.07);
  }
  .orb-wrap:hover .orb-drift {
    animation-play-state: paused;
  }

  .orb-label {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    color: var(--ink-dim);
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity 0.6s cubic-bezier(0.33, 0.02, 0.24, 1),
      transform 0.6s cubic-bezier(0.33, 0.02, 0.24, 1);
    white-space: nowrap;
    text-align: center;
  }
  .orb-wrap:hover .orb-label,
  .orb-wrap:focus-visible .orb-label {
    opacity: 0.75;
    transform: translateY(0);
  }

  /*
    Без мыши наведения не бывает. Показать все пять подписей разом нельзя —
    на узком экране они наезжают друг на друга и на само кольцо, и мандала
    превращается в список. Поэтому они проступают по очереди, по одной за раз:
    за полминуты успеваешь прочитать все, композиция при этом не ломается.
  */
  @media (hover: none) {
    .orb-label {
      animation: label-turn 17s var(--ease-amb) infinite;
      transform: translateY(0);
    }
    #o-white .orb-label {
      animation-delay: 0s;
    }
    #o-blue .orb-label {
      animation-delay: 3.4s;
    }
    #o-red .orb-label {
      animation-delay: 6.8s;
    }
    #o-black .orb-label {
      animation-delay: 10.2s;
    }
    #o-green .orb-label {
      animation-delay: 13.6s;
    }
  }

  @keyframes label-turn {
    0%,
    100% {
      opacity: 0;
    }
    4% {
      opacity: 0.55;
    }
    16% {
      opacity: 0.55;
    }
    22% {
      opacity: 0;
    }
  }

  /*
    Без движения очередь не работает: все подписи замерли бы в одной фазе и
    снова наехали бы друг на друга. Имена меток остаются в aria-label — для
    доступности ничего не теряется.
  */
  @media (hover: none) and (prefers-reduced-motion: reduce) {
    .orb-label {
      opacity: 0;
    }
  }

  /* чёрная метка признаётся неохотнее остальных — подпись приходит с запозданием */
  #o-black .orb-label {
    transition-delay: 260ms;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(var(--dx, 4px), var(--dy, -6px));
    }
  }

  /* пять меток вокруг тихого центра — белая в зените, чёрная у корня */
  #o-white {
    top: calc(50% - 27vmin);
    left: 50%;
    --dx: 3px;
    --dy: -7px;
  }
  #o-blue {
    top: calc(50% - 8.7vmin);
    left: calc(50% + 25.7vmin);
    --dx: 6px;
    --dy: -4px;
  }
  #o-red {
    top: calc(50% + 21.8vmin);
    left: calc(50% + 15.9vmin);
    --dx: -4px;
    --dy: -5px;
  }
  #o-black {
    top: calc(50% + 21.8vmin);
    left: calc(50% - 15.9vmin);
    --dx: 5px;
    --dy: 5px;
  }
  #o-green {
    top: calc(50% - 8.7vmin);
    left: calc(50% - 25.7vmin);
    --dx: -5px;
    --dy: -6px;
  }

  /*
    На узком экране кольцо разводится шире: vmin там равен ширине, и при
    настольном радиусе мандала сжималась в комок посреди высокого экрана.
  */
  @media (max-width: 640px) {
    #o-white {
      top: calc(50% - 29vmin);
    }
    #o-blue {
      top: calc(50% - 9.3vmin);
      left: calc(50% + 27.6vmin);
    }
    #o-red {
      top: calc(50% + 23.5vmin);
      left: calc(50% + 17vmin);
    }
    #o-black {
      top: calc(50% + 23.5vmin);
      left: calc(50% - 17vmin);
    }
    #o-green {
      top: calc(50% - 9.3vmin);
      left: calc(50% - 27.6vmin);
    }
    .orb-label {
      font-size: 11.5px;
    }
    .enso {
      width: 72vmin;
      height: 72vmin;
    }
  }
</style>
