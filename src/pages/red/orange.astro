---
import Room from '../../layouts/Room.astro';
import BrushMark from '../../components/BrushMark.astro';
---

<Room branch="red" slug="orange">
  <div class="stage">
    <div class="pulse-wrap">
      <span class="halo" aria-hidden="true"></span>
      {/* та же кистевая метка, что и на мандале: залитый круг читался бы
          светящимся шаром, а этого в проекте быть не должно */}
      <span class="blot">
        <BrushMark branch="red" size={260} />
      </span>
      <span class="offbeat" aria-hidden="true"></span>
    </div>

    <p class="sr-only">Пятно пульсирует в ровном собственном ритме; рядом отбивается второй, чуть более частый.</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0 var(--pad-x);
  }

  .pulse-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(180px, 30vmin, 320px);
    aspect-ratio: 1;
  }

  .blot {
    display: block;
    width: clamp(146px, 25vmin, 256px);
    /* наклон разводит эту метку с такой же в жёлтой комнате: один словарь форм,
       но два разных почерка */
    rotate: 9deg;
    transform-origin: 50% 50%;
    /*
      Ровный пульс 1.15 с — чуть быстрее спокойного сердца. Нетерпение берётся
      не из скорости, а из того, что удар короткий, а пауза длинная.
    */
    animation: beat 1.15s var(--ease-micro) infinite;
    --rest-offset: -0.575s;
  }

  .blot :global(svg) {
    width: 100%;
    height: auto;
  }

  @keyframes beat {
    0% {
      scale: 1;
      opacity: 0.86;
    }
    7% {
      scale: 1.085;
      opacity: 1;
    }
    19% {
      scale: 0.995;
    }
    30% {
      scale: 1;
      opacity: 0.86;
    }
    100% {
      scale: 1;
      opacity: 0.86;
    }
  }

  /* отзвук удара, а не подсветка объекта: слабее и шире самой метки */
  .halo {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--c-red) 13%, transparent) 0%, transparent 58%);
    animation: halo-beat 1.15s var(--ease-micro) infinite;
    --rest-offset: -0.575s;
  }

  @keyframes halo-beat {
    0% {
      scale: 0.94;
      opacity: 0.4;
    }
    9% {
      scale: 1.1;
      opacity: 0.85;
    }
    46% {
      scale: 0.94;
      opacity: 0.4;
    }
    100% {
      scale: 0.94;
      opacity: 0.4;
    }
  }

  /*
    Второй ритм — 1.31 с. Он не совпадает с первым и никогда не совпадёт:
    два такта медленно расходятся и снова сходятся, и это единственное, что
    здесь происходит.
  */
  .offbeat {
    position: absolute;
    bottom: -14%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-red);
    opacity: 0.5;
    animation: offbeat 1.31s var(--ease-micro) infinite;
    --rest-offset: -0.655s;
  }

  @keyframes offbeat {
    0% {
      scale: 1;
      opacity: 0.32;
    }
    8% {
      scale: 2.1;
      opacity: 0.8;
    }
    34% {
      scale: 1;
      opacity: 0.32;
    }
    100% {
      scale: 1;
      opacity: 0.32;
    }
  }
</style>
