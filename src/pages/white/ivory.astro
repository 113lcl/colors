---
import Room from '../../layouts/Room.astro';
---

<Room branch="white" slug="ivory">
  <div class="stage">
    <button class="surface" type="button" id="surface" aria-label="Следующая фраза">
      <p class="phrase" id="phrase">Здесь ничего не нужно успевать.</p>
    </button>
    <p class="cue" id="cue">нажмите, когда дочитаете</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding: 14vh var(--pad-x) 16vh;
  }

  .surface {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    cursor: pointer;
    text-align: left;
    align-self: center;
    display: flex;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .phrase {
    margin: 0;
    /* ch считается от кегля самой фразы — на кнопке он был бы от 14px и всё схлопнулось бы */
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(27px, 6.2vw, 62px);
    line-height: 1.34;
    letter-spacing: 0.015em;
    color: var(--c-white);
    text-wrap: balance;
    /* уход фразы: растворение, а не смена — белая ветка ничего не обрывает */
    transition:
      opacity 900ms var(--ease-state),
      transform 900ms var(--ease-state),
      filter 900ms var(--ease-state);
  }

  .phrase.is-leaving {
    opacity: 0;
    transform: translateY(-10px);
    filter: blur(7px);
  }

  .surface:focus-visible {
    outline-offset: 22px;
  }

  .cue {
    margin: 0;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--ink-dim);
    opacity: 0;
    animation: cue-in 3.4s var(--ease-state) 2.6s forwards;
    --rest-offset: 0s;
  }

  @keyframes cue-in {
    to {
      opacity: 0.34;
    }
  }

  .cue.is-gone {
    animation: none;
    opacity: 0;
    transition: opacity 1.4s var(--ease-state);
  }

  @media (max-width: 640px) {
    .phrase {
      max-width: 12ch;
    }
  }
</style>

<script>
  import { revealText } from '../../scripts/techniques/reveal-text.js';
  import { reduced } from '../../scripts/techniques/_util.js';

  /*
    Фразы белой ветки: забота без наставления. Каждая — законченная мысль,
    которую не нужно продолжать; порядок задан, а не случаен, чтобы тон нарастал
    от «можно остановиться» к «можно уйти».
  */
  const PHRASES = [
    'Здесь ничего не нужно успевать.',
    'Можно просто смотреть.',
    'Вы ничего не пропустили.',
    'Дышится ровно настолько, насколько дышится.',
    'Тише, чем кажется.',
    'Всё остальное подождёт столько, сколько нужно.',
    'Уйти отсюда можно в любую секунду.',
  ];

  const surface = document.getElementById('surface');
  const phrase = document.getElementById('phrase');
  const cue = document.getElementById('cue');

  let index = 0;
  let busy = false;

  const show = (text) => {
    phrase.dataset.text = text;
    phrase.classList.remove('is-leaving');
    revealText(phrase, { unit: 'word', base: 118, pace: 1, startDelay: reduced() ? 0 : 420 });
  };

  show(PHRASES[0]);

  surface?.addEventListener('click', () => {
    if (busy) return;
    busy = true;
    cue?.classList.add('is-gone');

    phrase.classList.add('is-leaving');
    const wait = reduced() ? 60 : 900;
    setTimeout(() => {
      index = (index + 1) % PHRASES.length;
      show(PHRASES[index]);
      busy = false;
    }, wait);
  });
</script>
