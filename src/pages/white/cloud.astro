---
import Room from '../../layouts/Room.astro';
---

<Room branch="white" slug="cloud">
  <div class="stage">
    <div class="form-wrap">
      <span class="halo" aria-hidden="true"></span>
      <button class="form" type="button" id="form" aria-label="Форма, которая начинает дышать, если задержаться на ней">
        <svg viewBox="-140 -140 280 280" aria-hidden="true">
          <path
            d="M-70-82C-2-112 74-80 97-16C121 50 66 107 2 103C-60 100-108 49-94-17C-89-45-83-68-70-82Z"
            fill="none"
            stroke="var(--c-white)"
            stroke-width="46"
            stroke-linecap="round"
            stroke-linejoin="round"
            opacity=".5"></path>
          <path d="M-93 12C-78 80-4 110 57 82" fill="none" stroke="var(--c-white)" stroke-width="17" stroke-linecap="round" opacity=".34"></path>
          <circle cx="-100" cy="38" r="5" fill="var(--c-white)" opacity=".4"></circle>
          <circle cx="-91" cy="57" r="3" fill="var(--c-white)" opacity=".3"></circle>
        </svg>
      </button>
    </div>

    <p class="whisper" id="whisper">задержитесь</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    place-items: center;
    grid-template-rows: 1fr auto;
    padding: 12vh var(--pad-x) 16vh;
  }

  .form-wrap {
    position: relative;
    display: grid;
    place-items: center;
    align-self: center;
  }

  /* ореол — единственная обратная связь на удержание: комната замечает, что её слушают */
  .halo {
    position: absolute;
    width: clamp(240px, 42vmin, 460px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--c-white) 26%, transparent) 0%, transparent 68%);
    opacity: calc(var(--dwell, 0) * 0.5);
    transform: scale(calc(0.86 + var(--dwell, 0) * 0.16));
    transition:
      opacity 700ms var(--ease-state),
      transform 900ms var(--ease-state);
    pointer-events: none;
  }

  .form {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: default;
    display: block;
    width: clamp(190px, 34vmin, 360px);
    aspect-ratio: 1;
  }

  .form svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    transform-origin: 50% 50%;
    /* покой: еле заметный дрейф, чтобы форма не выглядела приклеенной */
    animation: adrift 21s var(--ease-amb) infinite;
    --rest-offset: -10.5s;
  }

  @keyframes adrift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(0, -7px, 0) scale(1.006);
    }
  }

  /*
    Выдох. Белая грамматика: длинно, плавно, без всякого перелёта —
    сжатие заметно медленнее, чем возврат, как настоящий выдох.
  */
  .form.is-breathing svg {
    animation: exhale 7.4s var(--ease-amb) infinite;
    --rest-offset: -3.7s;
  }

  @keyframes exhale {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }
    46% {
      transform: translate3d(0, 6px, 0) scale(0.918);
      opacity: 0.82;
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }
  }

  .whisper {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--ink-dim);
    opacity: 0.36;
    transition:
      opacity 1.2s var(--ease-state),
      transform 1.2s var(--ease-state);
  }

  .whisper.is-quiet {
    opacity: 0;
    transform: translateY(4px);
  }

  .form:focus-visible {
    outline-offset: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .halo {
      transition: none;
    }
  }
</style>

<script>
  import { dwell } from '../../scripts/techniques/dwell.js';

  const form = document.getElementById('form');
  const whisper = document.getElementById('whisper');
  const wrap = form?.closest('.form-wrap');

  if (form && wrap) {
    dwell(form, {
      hold: 1150,
      onProgress: (p) => wrap.style.setProperty('--dwell', String(p)),
      onHold: () => {
        form.classList.add('is-breathing');
        whisper?.classList.add('is-quiet');
      },
      onRelease: () => {
        form.classList.remove('is-breathing');
        // подсказка возвращается не сразу: пусть тишина продержится
        setTimeout(() => whisper?.classList.remove('is-quiet'), 2600);
      },
    });
  }
</script>
