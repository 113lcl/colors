---
import Room from '../../layouts/Room.astro';
---

<Room branch="green" slug="mint">
  <div class="stage">
    <div class="field">
      <div class="drop" id="drop">
        <svg viewBox="-120 -120 240 240" aria-hidden="true">
          <path
            class="outer"
            d="M-58-66C-9-96 58-70 79-22C101 30 66 88 10 92C-46 96-92 54-86-6C-83-33-74-56-58-66Z"
            fill="none"
            stroke="var(--c-green)"
            stroke-width="30"
            stroke-linecap="round"
            stroke-linejoin="round"
            opacity=".62"></path>
          <path class="inner" d="M-52 4C-44 52 3 78 48 56" fill="none" stroke="var(--c-green)" stroke-width="13" stroke-linecap="round" opacity=".5"></path>
          <circle class="bead" cx="-84" cy="26" r="6" fill="var(--c-green)" opacity=".55"></circle>
        </svg>
      </div>

      {
        /*
          Не точки по углам, а брызги от мазка: они летят в одну сторону,
          от крупных к мелким, и держатся рядом с каплей. Равномерно
          рассыпанные точки в темноте читались бы звёздным небом.
        */
        [
          { x: 63, y: 34, s: 0.62, d: 13 },
          { x: 69, y: 29, s: 0.4, d: 17 },
          { x: 74, y: 25, s: 0.26, d: 15 },
          { x: 60, y: 62, s: 0.5, d: 19 },
          { x: 66, y: 70, s: 0.3, d: 21 },
          { x: 38, y: 27, s: 0.34, d: 23 },
          { x: 33, y: 22, s: 0.2, d: 25 },
          { x: 44, y: 76, s: 0.24, d: 27 },
        ].map((s) => {
          // тяга к центру: чем ближе курсор, тем сильнее спутники подбираются
          // к капле. Направление считается на сборке, в браузере остаётся
          // умножение на одно число
          const tx = ((50 - s.x) * 0.34).toFixed(2);
          const ty = ((50 - s.y) * 0.34).toFixed(2);
          return (
            <span
              class="satellite"
              data-sat
              style={`left:${s.x}%; top:${s.y}%; --s:${s.s}; --dur:${s.d}s; --tx:${tx}%; --ty:${ty}%;`}
              aria-hidden="true"
            >
              <span class="sat-core" style={`--rest-offset:-${s.d / 2}s;`} />
            </span>
          );
        })
      }
    </div>

    <p class="cue" id="cue">подойдите ближе</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 10vh var(--pad-x) 15vh;
  }

  .field {
    position: relative;
    display: grid;
    place-items: center;
  }

  .drop {
    width: clamp(150px, 27vmin, 290px);
    aspect-ratio: 1;
    will-change: transform;
  }

  .drop svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    /* дыхание живёт отдельно от притяжения: магнит двигает .drop, дыхание — svg внутри */
    animation: drop-breathe 8.4s var(--ease-amb) infinite;
    --rest-offset: -4.2s;
  }

  @keyframes drop-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.045);
    }
  }

  /*
    Мелкие спутники. Им передаётся близость курсора, но иначе, чем капле: они
    не тянутся к нему, а подбираются к капле — комната как будто собирается
    вокруг того, на что смотрят. Зелёная грамматика, мягко и с перелётом.
  */
  /*
    Два слоя: внешний тянется к капле от близости курсора, внутренний живёт
    собственным дрейфом. В одном элементе анимация перебила бы translate,
    заданный переменной.
  */
  .satellite {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    translate: calc(var(--tx) * var(--near, 0)) calc(var(--ty) * var(--near, 0));
    transition: translate 1100ms var(--ease-state);
  }

  .sat-core {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--c-green);
    opacity: calc(0.18 + var(--near, 0) * 0.42);
    transform: scale(calc(var(--s) + var(--near, 0) * 0.62));
    transition:
      opacity 700ms var(--ease-state),
      transform 900ms var(--ease-state);
    animation: sat-drift var(--dur) var(--ease-amb) infinite;
  }

  @keyframes sat-drift {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 6px -9px;
    }
  }

  .cue {
    margin: 0;
    justify-self: center;
    font-family: var(--font-display);
    font-size: 11.5px;
    letter-spacing: 0.3em;
    color: var(--ink-dim);
    opacity: 0.34;
    transition: opacity 1100ms var(--ease-state);
  }

  .cue.is-quiet {
    opacity: 0;
  }
</style>

<script>
  import { magnetic } from '../../scripts/techniques/magnetic.js';
  import { hasPointer } from '../../scripts/techniques/_util.js';

  const drop = document.getElementById('drop');
  const cue = document.getElementById('cue');
  const sats = [...document.querySelectorAll('[data-sat]')];
  const field = drop?.closest('.field');

  if (drop && field) {
    magnetic(drop, {
      radius: 320,
      pull: 0.34,
      ease: 0.11,
      maxOffset: 64,
      breathe: 0.06,
      onNear: (near) => {
        field.style.setProperty('--near', near.toFixed(3));
        cue?.classList.toggle('is-quiet', near > 0.25);
      },
    });
  }

  // на тач-устройствах подсказка про «подойти ближе» бессмысленна
  if (!hasPointer() && cue) cue.textContent = 'просто побудьте';
</script>
