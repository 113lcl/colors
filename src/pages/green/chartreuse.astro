---
import Room from '../../layouts/Room.astro';
---

<Room branch="green" slug="chartreuse">
  <div class="stage">
    <p class="holding">Генеративный узор, каждый раз немного другой.</p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0 var(--pad-x);
  }
  .holding {
    max-width: 30ch;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(15px, 2vw, 19px);
    line-height: 1.7;
    color: var(--ink-dim);
    opacity: 0.5;
  }
</style>
