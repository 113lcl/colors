---
import Room from '../../layouts/Room.astro';

/*
  Кольца-наросты. Форма не растение и ничего не иллюстрирует — это просто след,
  который утолщается от того, что сюда возвращаются. Кольца нарисованы на сборке,
  показывает их скрипт по числу визитов.
*/
function prng(seed) {
  let s = seed;
  return () => {
    s = (s * 1103515245 + 12345) % 2147483648;
    return s / 2147483648;
  };
}

const rand = prng(4821);

/* Замкнутый гладкий контур через точки (Catmull-Rom → безье): мазок, а не многоугольник. */
function closedCurve(points) {
  const n = points.length;
  const at = (i) => points[(i + n) % n];
  let d = `M ${at(0)[0].toFixed(1)} ${at(0)[1].toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const p0 = at(i - 1);
    const p1 = at(i);
    const p2 = at(i + 1);
    const p3 = at(i + 2);
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C ${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return `${d} Z`;
}

const RINGS = Array.from({ length: 9 }, (_, i) => {
  const r = 40 + i * 13.5;
  const pts = 9;
  const tilt = rand() * Math.PI;
  const points = Array.from({ length: pts }, (_, k) => {
    const a = (k / pts) * Math.PI * 2 + tilt;
    // радиус гуляет — рука не держит окружность ровно
    const rr = r * (0.87 + rand() * 0.26);
    return [Math.cos(a) * rr, Math.sin(a) * rr * 0.93];
  });

  return {
    d: closedCurve(points),
    width: (8.5 - i * 0.66).toFixed(2),
    opacity: (0.58 - i * 0.045).toFixed(2),
    dur: (9 + rand() * 7).toFixed(1),
    delay: (rand() * 6).toFixed(1),
  };
});

/* Первые три кольца есть всегда: комната не должна встречать пустотой. */
const BASE_RINGS = 3;
---

<Room branch="green" slug="sage">
  <div class="stage">
    <div class="knot" id="knot" data-base={BASE_RINGS}>
      <svg viewBox="-190 -190 380 380" aria-hidden="true">
        {
          RINGS.map((ring, i) => (
            <path
              class="ring"
              data-index={i}
              d={ring.d}
              fill="none"
              stroke="var(--c-green)"
              stroke-width={ring.width}
              stroke-linejoin="round"
              stroke-linecap="round"
              style={`--o:${ring.opacity}; --dur:${ring.dur}s; --delay:-${ring.delay}s; --rest-offset:-${Number(ring.dur) / 2}s;`}
            />
          ))
        }
      </svg>
    </div>

    <p class="note" id="note"></p>
  </div>
</Room>

<style>
  .stage {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding: 12vh var(--pad-x) 15vh;
  }

  .knot {
    width: clamp(220px, 44vmin, 470px);
    aspect-ratio: 1;
    align-self: center;
    /* --growth приходит из localStorage: чем чаще заходят, тем крупнее след */
    transform: scale(calc(0.82 + var(--growth, 0) * 0.3));
    transition: transform 1400ms var(--ease-state);
  }

  .knot svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .ring {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    opacity: 0;
    transform: scale(0.72);
    /* зелёная грамматика: мягкая пружина с лёгким перелётом */
    transition:
      opacity 900ms var(--ease-state),
      transform 1100ms var(--ease-state);
  }

  .ring.is-grown {
    opacity: var(--o);
    transform: scale(1);
    animation: ring-sway var(--dur) var(--ease-amb) var(--delay) infinite;
  }

  @keyframes ring-sway {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.022) rotate(0.9deg);
    }
  }

  .note {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.24em;
    color: var(--ink-dim);
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 1500ms var(--ease-state),
      transform 1500ms var(--ease-state);
  }

  .note.is-in {
    opacity: 0.42;
    transform: translateY(0);
  }
</style>

<script>
  import { accumulate } from '../../scripts/techniques/accumulate.js';
  import { reduced } from '../../scripts/techniques/_util.js';

  const knot = document.getElementById('knot');
  const note = document.getElementById('note');
  const rings = [...document.querySelectorAll('.ring')];

  const base = Number(knot.dataset.base) || 3;
  const { value, visits } = accumulate('sage', { cap: rings.length - base });

  knot.style.setProperty('--growth', String(value));

  // база есть всегда; дальше по кольцу за визит, пока не упрётся в потолок
  const shown = Math.min(base + Math.max(visits - 1, 0), rings.length);

  rings.forEach((ring, i) => {
    if (i >= shown) return;
    const wait = reduced() ? 0 : 260 + i * 130;
    setTimeout(() => ring.classList.add('is-grown'), wait);
  });

  /*
    Текст не считает визиты вслух: число превратило бы комнату в счётчик очков.
    Говорится только то, что след стал плотнее — и только начиная со второго раза.
  */
  const PHRASES = [
    'след только начался',
    'здесь уже бывали',
    'стало плотнее',
    'слой поверх слоя',
    'это накопилось само',
  ];
  const phrase = visits <= 1 ? PHRASES[0] : PHRASES[Math.min(Math.floor(visits / 2) + 1, PHRASES.length - 1)];

  note.textContent = phrase;
  setTimeout(() => note.classList.add('is-in'), reduced() ? 0 : 1100 + shown * 120);
</script>
